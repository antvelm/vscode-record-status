{
    "name": "md-status",
    "displayName": "MD Status",
    "description": "Shows the status written inside a Markdown file (tasks, decisions, specs, ADRs) as the file's icon, name colour and folder progress in the Explorer. File names never change.",
    "version": "0.4.2",
    "publisher": "manapotionstudios",
    "author": { "name": "Mana Potion Studios UG (haftungsbeschränkt)", "url": "https://github.com/antvelm" },
    "license": "MIT",
    "icon": "icon.png",
    "repository": { "type": "git", "url": "https://github.com/antvelm/vscode-md-status" },
    "homepage": "https://github.com/antvelm/vscode-md-status#readme",
    "bugs": { "url": "https://github.com/antvelm/vscode-md-status/issues" },
    "engines": { "vscode": "^1.72.0" },
    "categories": ["Themes", "Other"],
    "keywords": ["markdown", "status", "tasks", "adr", "decisions", "explorer", "icons", "decorations", "progress"],
    "activationEvents": ["onStartupFinished"],
    "main": "./extension.js",
    "scripts": {
        "build-theme": "node scripts/build-theme.js",
        "vscode:prepublish": "node scripts/build-theme.js",
        "test": "node --test",
        "showcase": "node scripts/build-showcase.js"
    },
    "devDependencies": {
        "material-icon-theme": "5.39.0"
    },
    "contributes": {
        "iconThemes": [
            {
                "id": "md-status-icons",
                "label": "MD Status Icons",
                "path": "./theme/md-status-icons.json",
                "_watch": true
            }
        ],
        "commands": [
            { "command": "mdStatus.configure", "title": "Configure…", "category": "MD Status" },
            { "command": "mdStatus.showLog", "title": "Show Log", "category": "MD Status" }
        ],
        "configuration": {
            "title": "MD Status",
            "properties": {
                "mdStatus.profiles": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Kinds of record, in order: the first profile whose `include` globs match a file owns it. Each profile has `include` (globs relative to the workspace folder), an optional `statusPattern`, and `statuses` (word → look). Empty uses the built-in profiles: `task` (`**/tasks/*.md`), `decision` (`**/decisions/*.md`), `spec` (`**/spec/*.md`) and `reference` (`**/assessments/*.md`).",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "include": { "type": "array", "items": { "type": "string" }, "description": "Globs, relative to the workspace folder, of this kind's files." },
                            "statusPattern": { "type": "string", "description": "Regular expression that finds the status; the first group is it. Defaults to mdStatus.statusPattern." },
                            "statuses": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "object",
                                    "properties": {
                                        "icon": { "type": "string", "description": "Material Icon Theme icon name, e.g. \"todo\", \"verified\", \"key\". Empty keeps the file's icon." },
                                        "iconColor": { "type": "string", "description": "Material palette colour (\"amber-500\", \"gray-500\", …) or a hex colour." },
                                        "nameColor": { "type": "string", "description": "Theme colour id for the file name, e.g. \"mdStatus.completed\". Empty leaves the name alone." },
                                        "badge": { "type": "string", "description": "Up to two characters always shown after the name." },
                                        "glyph": { "type": "string", "description": "Up to two characters shown after the name when icons are not available (badge mode)." },
                                        "rollup": { "type": "string", "enum": ["done", "skip"], "description": "For folder roll-up: \"done\" counts as done, \"skip\" is not counted." }
                                    }
                                }
                            }
                        }
                    }
                },
                "mdStatus.statusPattern": {
                    "type": "string",
                    "default": "\\*\\*Status:\\*\\*\\s*([A-Za-z-]+)",
                    "description": "Default regular expression that finds the status inside a file. The first capture group is the status. It is lower-cased, and anything from \" by \" on is dropped."
                },
                "mdStatus.iconMode": {
                    "type": "string",
                    "enum": ["auto", "bundled", "material", "badge", "off"],
                    "enumDescriptions": [
                        "Bundled when MD Status Icons is the active file icon theme, Material when Material Icon Theme is, otherwise badges.",
                        "Use this extension's icon theme, MD Status Icons. Writes nothing into the workspace. Falls back to badges while another icon theme is active.",
                        "Material Icon Theme clones, written into the workspace settings (material-icon-theme.files.customClones).",
                        "No icon change: a coloured glyph after the file name.",
                        "Name colour only."
                    ],
                    "default": "auto",
                    "description": "How a record's status reaches its Explorer icon."
                },
                "mdStatus.colorPreset": {
                    "type": "string",
                    "enum": ["git", "classic", "soft", "theme", "quiet", "monochrome", "dark", "none"],
                    "enumDescriptions": [
                        "The colours git uses in the Explorer: modified (active), added (done), deleted (blocked), ignored (dropped). The default.",
                        "MD Status's own colours (mdStatus.* colour ids; retune them in workbench.colorCustomizations).",
                        "The classic colours with lower contrast: blended a third of the way toward the background (mdStatus.soft.* ids).",
                        "Follow the active colour theme: its chart and terminal colours.",
                        "Colour only what needs attention: active, check, blocked, open or in review, dropped.",
                        "Shades of grey, icons included: what needs attention is brightest, done is mid, dropped is dimmest (mdStatus.mono.* ids). In bundled mode every icon turns grey; for Material Icon Theme, set material-icon-theme.saturation to 0.",
                        "Deeper, muted versions of the classic colours (mdStatus.dark.* ids).",
                        "No name colours; icons and badges only."
                    ],
                    "default": "git",
                    "description": "Which colours file and folder names take for each status."
                },
                "mdStatus.colors": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Per-slot overrides on top of `colorPreset`: slot → theme colour id, or `\"\"` for no colour. Slots: `planned`, `inProgress`, `check`, `completed`, `blocked`, `living`, `dropped`, `proposed`. Example: `{ \"completed\": \"charts.green\", \"planned\": \"\" }`. For an exact hex colour, keep the slot on its `mdStatus.<slot>` id and set that id in `workbench.colorCustomizations`.",
                    "properties": {
                        "planned": { "type": "string" }, "inProgress": { "type": "string" }, "check": { "type": "string" },
                        "completed": { "type": "string" }, "blocked": { "type": "string" }, "living": { "type": "string" },
                        "dropped": { "type": "string" }, "proposed": { "type": "string" }
                    },
                    "additionalProperties": false
                },
                "mdStatus.rollup": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Folder progress badges: the percentage of records that are done, `✓` at 100%. `enabled` (default true), `profiles` (whose records count; default `[\"task\"]`), `folders` (globs of folders that get a badge; empty means the folder above each record's folder, e.g. `SavesV2` for `SavesV2/tasks/*.md`), `nameColor` (folder name colour at 100%; default `mdStatus.completed`).",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "profiles": { "type": "array", "items": { "type": "string" } },
                        "folders": { "type": "array", "items": { "type": "string" } },
                        "nameColor": { "type": "string" }
                    }
                },
                "mdStatus.include": {
                    "type": "array",
                    "items": { "type": "string" },
                    "markdownDeprecationMessage": "Use `mdStatus.profiles`. Still read, as one profile, when `profiles` is empty.",
                    "description": "0.2: globs of the files whose status is shown."
                },
                "mdStatus.statuses": {
                    "type": "object",
                    "markdownDeprecationMessage": "Use `mdStatus.profiles`. Still read, as one profile, when `profiles` is empty.",
                    "description": "0.2: what each status looks like."
                },
                "mdStatus.icons": {
                    "type": "boolean",
                    "default": true,
                    "markdownDeprecationMessage": "Use `mdStatus.iconMode`; `false` here means `off`.",
                    "description": "0.2: replace the file icon with the status icon."
                }
            }
        },
        "colors": [
            { "id": "mdStatus.planned",    "description": "Planned / draft",          "defaults": { "dark": "#8a8f98", "light": "#6b7280", "highContrast": "#8a8f98" } },
            { "id": "mdStatus.inProgress", "description": "In progress / active",     "defaults": { "dark": "#e0a800", "light": "#b45309", "highContrast": "#e0a800" } },
            { "id": "mdStatus.check",      "description": "Built, waiting for a look", "defaults": { "dark": "#22b8cf", "light": "#0e7490", "highContrast": "#22b8cf" } },
            { "id": "mdStatus.completed",  "description": "Completed / accepted",     "defaults": { "dark": "#3cb371", "light": "#15803d", "highContrast": "#3cb371" } },
            { "id": "mdStatus.blocked",    "description": "Blocked",                  "defaults": { "dark": "#f0605d", "light": "#b91c1c", "highContrast": "#f0605d" } },
            { "id": "mdStatus.living",     "description": "Spec being built",         "defaults": { "dark": "#6cb6ff", "light": "#1d4ed8", "highContrast": "#6cb6ff" } },
            { "id": "mdStatus.dropped",    "description": "Dropped / superseded",     "defaults": { "dark": "#5a5f66", "light": "#9ca3af", "highContrast": "#5a5f66" } },
            { "id": "mdStatus.proposed",   "description": "Proposed / open / review", "defaults": { "dark": "#5aa0ff", "light": "#1d4ed8", "highContrast": "#5aa0ff" } },
            { "id": "mdStatus.mono.planned", "description": "Monochrome preset: planned / draft", "defaults": { "dark": "#8c8c8c", "light": "#767676", "highContrast": "#8c8c8c" } },
            { "id": "mdStatus.mono.inProgress", "description": "Monochrome preset: in progress / active", "defaults": { "dark": "#f0f0f0", "light": "#1a1a1a", "highContrast": "#f0f0f0" } },
            { "id": "mdStatus.mono.check", "description": "Monochrome preset: built, waiting for a look", "defaults": { "dark": "#f0f0f0", "light": "#1a1a1a", "highContrast": "#f0f0f0" } },
            { "id": "mdStatus.mono.completed", "description": "Monochrome preset: completed / accepted", "defaults": { "dark": "#b4b4b4", "light": "#555555", "highContrast": "#b4b4b4" } },
            { "id": "mdStatus.mono.blocked", "description": "Monochrome preset: blocked", "defaults": { "dark": "#ffffff", "light": "#000000", "highContrast": "#ffffff" } },
            { "id": "mdStatus.mono.living", "description": "Monochrome preset: spec being built", "defaults": { "dark": "#b4b4b4", "light": "#555555", "highContrast": "#b4b4b4" } },
            { "id": "mdStatus.mono.dropped", "description": "Monochrome preset: dropped / superseded", "defaults": { "dark": "#5f5f5f", "light": "#ababab", "highContrast": "#5f5f5f" } },
            { "id": "mdStatus.mono.proposed", "description": "Monochrome preset: proposed / open / review", "defaults": { "dark": "#f0f0f0", "light": "#1a1a1a", "highContrast": "#f0f0f0" } },
            { "id": "mdStatus.dark.planned", "description": "Dark preset: planned / draft", "defaults": { "dark": "#6e7681", "light": "#57606a", "highContrast": "#6e7681" } },
            { "id": "mdStatus.dark.inProgress", "description": "Dark preset: in progress / active", "defaults": { "dark": "#c69026", "light": "#8a5a00", "highContrast": "#c69026" } },
            { "id": "mdStatus.dark.check", "description": "Dark preset: built, waiting for a look", "defaults": { "dark": "#1b9aaa", "light": "#0b5c6e", "highContrast": "#1b9aaa" } },
            { "id": "mdStatus.dark.completed", "description": "Dark preset: completed / accepted", "defaults": { "dark": "#3f9b5c", "light": "#1a6b33", "highContrast": "#3f9b5c" } },
            { "id": "mdStatus.dark.blocked", "description": "Dark preset: blocked", "defaults": { "dark": "#c9514f", "light": "#8f1d1d", "highContrast": "#c9514f" } },
            { "id": "mdStatus.dark.living", "description": "Dark preset: spec being built", "defaults": { "dark": "#4a83c9", "light": "#1c3f8f", "highContrast": "#4a83c9" } },
            { "id": "mdStatus.dark.dropped", "description": "Dark preset: dropped / superseded", "defaults": { "dark": "#4b5058", "light": "#8c959f", "highContrast": "#4b5058" } },
            { "id": "mdStatus.dark.proposed", "description": "Dark preset: proposed / open / review", "defaults": { "dark": "#6f7fc4", "light": "#3a4a9f", "highContrast": "#6f7fc4" } },
            { "id": "mdStatus.soft.planned", "description": "Soft preset: planned / draft", "defaults": { "dark": "#65686e", "light": "#9fa3ac", "highContrast": "#8a8f98" } },
            { "id": "mdStatus.soft.inProgress", "description": "Soft preset: in progress / active", "defaults": { "dark": "#9c780b", "light": "#ce8f5f", "highContrast": "#e0a800" } },
            { "id": "mdStatus.soft.check", "description": "Soft preset: built, waiting for a look", "defaults": { "dark": "#218291", "light": "#62a5b7", "highContrast": "#22b8cf" } },
            { "id": "mdStatus.soft.completed", "description": "Soft preset: completed / accepted", "defaults": { "dark": "#327f54", "light": "#67ac81", "highContrast": "#3cb371" } },
            { "id": "mdStatus.soft.blocked", "description": "Soft preset: blocked", "defaults": { "dark": "#a74947", "light": "#d26b6b", "highContrast": "#f0605d" } },
            { "id": "mdStatus.soft.living", "description": "Soft preset: spec being built", "defaults": { "dark": "#5181b1", "light": "#6c8ce6", "highContrast": "#6cb6ff" } },
            { "id": "mdStatus.soft.dropped", "description": "Soft preset: dropped / superseded", "defaults": { "dark": "#45494d", "light": "#bfc3cb", "highContrast": "#5a5f66" } },
            { "id": "mdStatus.soft.proposed", "description": "Soft preset: proposed / open / review", "defaults": { "dark": "#4573b1", "light": "#6c8ce6", "highContrast": "#5aa0ff" } }
        ]
    }
}
