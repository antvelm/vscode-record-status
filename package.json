{
    "name": "record-status",
    "displayName": "Record Status",
    "description": "Shows the status written inside a Markdown file (tasks, decisions, specs, ADRs) as the file's icon, name colour and folder progress in the Explorer. File names never change.",
    "version": "0.3.0",
    "publisher": "antvelm",
    "license": "MIT",
    "icon": "icon.png",
    "repository": { "type": "git", "url": "https://github.com/antvelm/vscode-record-status" },
    "engines": { "vscode": "^1.72.0" },
    "categories": ["Themes", "Other"],
    "keywords": ["markdown", "status", "tasks", "adr", "decisions", "explorer", "icons", "decorations", "progress"],
    "activationEvents": ["onStartupFinished"],
    "main": "./extension.js",
    "scripts": {
        "build-theme": "node scripts/build-theme.js",
        "vscode:prepublish": "node scripts/build-theme.js",
        "test": "node --test",
        "showcase": "node scripts/build-showcase.js"
    },
    "devDependencies": {
        "material-icon-theme": "5.39.0"
    },
    "contributes": {
        "iconThemes": [
            {
                "id": "record-status-icons",
                "label": "Record Status Icons",
                "path": "./theme/record-status-icons.json",
                "_watch": true
            }
        ],
        "commands": [
            { "command": "recordStatus.configure", "title": "Configure…", "category": "Record Status" },
            { "command": "recordStatus.showLog", "title": "Show Log", "category": "Record Status" }
        ],
        "configuration": {
            "title": "Record Status",
            "properties": {
                "recordStatus.profiles": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Kinds of record, in order: the first profile whose `include` globs match a file owns it. Each profile has `include` (globs relative to the workspace folder), an optional `statusPattern`, and `statuses` (word → look). Empty uses the built-in profiles: `task` (`**/tasks/*.md`), `decision` (`**/decisions/*.md`), `spec` (`**/spec/*.md`) and `reference` (`**/assessments/*.md`).",
                    "additionalProperties": {
                        "type": "object",
                        "properties": {
                            "include": { "type": "array", "items": { "type": "string" }, "description": "Globs, relative to the workspace folder, of this kind's files." },
                            "statusPattern": { "type": "string", "description": "Regular expression that finds the status; the first group is it. Defaults to recordStatus.statusPattern." },
                            "statuses": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": "object",
                                    "properties": {
                                        "icon": { "type": "string", "description": "Material Icon Theme icon name, e.g. \"todo\", \"verified\", \"key\". Empty keeps the file's icon." },
                                        "iconColor": { "type": "string", "description": "Material palette colour (\"amber-500\", \"gray-500\", …) or a hex colour." },
                                        "nameColor": { "type": "string", "description": "Theme colour id for the file name, e.g. \"recordStatus.completed\". Empty leaves the name alone." },
                                        "badge": { "type": "string", "description": "Up to two characters always shown after the name." },
                                        "glyph": { "type": "string", "description": "Up to two characters shown after the name when icons are not available (badge mode)." },
                                        "rollup": { "type": "string", "enum": ["done", "skip"], "description": "For folder roll-up: \"done\" counts as done, \"skip\" is not counted." }
                                    }
                                }
                            }
                        }
                    }
                },
                "recordStatus.statusPattern": {
                    "type": "string",
                    "default": "\\*\\*Status:\\*\\*\\s*([A-Za-z-]+)",
                    "description": "Default regular expression that finds the status inside a file. The first capture group is the status. It is lower-cased, and anything from \" by \" on is dropped."
                },
                "recordStatus.iconMode": {
                    "type": "string",
                    "enum": ["auto", "bundled", "material", "badge", "off"],
                    "enumDescriptions": [
                        "Bundled when Record Status Icons is the active file icon theme, Material when Material Icon Theme is, otherwise badges.",
                        "Use this extension's icon theme, Record Status Icons. Writes nothing into the workspace. Falls back to badges while another icon theme is active.",
                        "Material Icon Theme clones, written into the workspace settings (material-icon-theme.files.customClones).",
                        "No icon change: a coloured glyph after the file name.",
                        "Name colour only."
                    ],
                    "default": "auto",
                    "description": "How a record's status reaches its Explorer icon."
                },
                "recordStatus.colorPreset": {
                    "type": "string",
                    "enum": ["default", "theme", "git", "quiet", "monochrome", "dark", "none"],
                    "enumDescriptions": [
                        "Record Status's own colours (recordStatus.* colour ids; retune them in workbench.colorCustomizations).",
                        "Follow the active colour theme: its chart and terminal colours.",
                        "The colours git uses in the Explorer: modified (active), added (done), deleted (blocked), ignored (dropped).",
                        "Colour only what needs attention: active, check, blocked, open or in review, dropped.",
                        "Shades of grey: what needs attention is brightest, done is mid, dropped is dimmest (recordStatus.mono.* ids).",
                        "Deeper, muted versions of the default colours (recordStatus.dark.* ids).",
                        "No name colours; icons and badges only."
                    ],
                    "default": "default",
                    "description": "Which colours file and folder names take for each status."
                },
                "recordStatus.colors": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Per-slot overrides on top of `colorPreset`: slot → theme colour id, or `\"\"` for no colour. Slots: `planned`, `inProgress`, `check`, `completed`, `blocked`, `living`, `dropped`, `proposed`. Example: `{ \"completed\": \"charts.green\", \"planned\": \"\" }`. For an exact hex colour, keep the slot on its `recordStatus.<slot>` id and set that id in `workbench.colorCustomizations`.",
                    "properties": {
                        "planned": { "type": "string" }, "inProgress": { "type": "string" }, "check": { "type": "string" },
                        "completed": { "type": "string" }, "blocked": { "type": "string" }, "living": { "type": "string" },
                        "dropped": { "type": "string" }, "proposed": { "type": "string" }
                    },
                    "additionalProperties": false
                },
                "recordStatus.rollup": {
                    "type": "object",
                    "default": {},
                    "markdownDescription": "Folder progress badges: the percentage of records that are done, `✓` at 100%. `enabled` (default true), `profiles` (whose records count; default `[\"task\"]`), `folders` (globs of folders that get a badge; empty means the folder above each record's folder, e.g. `SavesV2` for `SavesV2/tasks/*.md`), `nameColor` (folder name colour at 100%; default `recordStatus.completed`).",
                    "properties": {
                        "enabled": { "type": "boolean" },
                        "profiles": { "type": "array", "items": { "type": "string" } },
                        "folders": { "type": "array", "items": { "type": "string" } },
                        "nameColor": { "type": "string" }
                    }
                },
                "recordStatus.include": {
                    "type": "array",
                    "items": { "type": "string" },
                    "markdownDeprecationMessage": "Use `recordStatus.profiles`. Still read, as one profile, when `profiles` is empty.",
                    "description": "0.2: globs of the files whose status is shown."
                },
                "recordStatus.statuses": {
                    "type": "object",
                    "markdownDeprecationMessage": "Use `recordStatus.profiles`. Still read, as one profile, when `profiles` is empty.",
                    "description": "0.2: what each status looks like."
                },
                "recordStatus.icons": {
                    "type": "boolean",
                    "default": true,
                    "markdownDeprecationMessage": "Use `recordStatus.iconMode`; `false` here means `off`.",
                    "description": "0.2: replace the file icon with the status icon."
                }
            }
        },
        "colors": [
            { "id": "recordStatus.planned",    "description": "Planned / draft",          "defaults": { "dark": "#8a8f98", "light": "#6b7280", "highContrast": "#8a8f98" } },
            { "id": "recordStatus.inProgress", "description": "In progress / active",     "defaults": { "dark": "#e0a800", "light": "#b45309", "highContrast": "#e0a800" } },
            { "id": "recordStatus.check",      "description": "Built, waiting for a look", "defaults": { "dark": "#22b8cf", "light": "#0e7490", "highContrast": "#22b8cf" } },
            { "id": "recordStatus.completed",  "description": "Completed / accepted",     "defaults": { "dark": "#3cb371", "light": "#15803d", "highContrast": "#3cb371" } },
            { "id": "recordStatus.blocked",    "description": "Blocked",                  "defaults": { "dark": "#f0605d", "light": "#b91c1c", "highContrast": "#f0605d" } },
            { "id": "recordStatus.living",     "description": "Spec being built",         "defaults": { "dark": "#6cb6ff", "light": "#1d4ed8", "highContrast": "#6cb6ff" } },
            { "id": "recordStatus.dropped",    "description": "Dropped / superseded",     "defaults": { "dark": "#5a5f66", "light": "#9ca3af", "highContrast": "#5a5f66" } },
            { "id": "recordStatus.proposed",   "description": "Proposed / open / review", "defaults": { "dark": "#5aa0ff", "light": "#1d4ed8", "highContrast": "#5aa0ff" } },
            { "id": "recordStatus.mono.planned", "description": "Monochrome preset: planned / draft", "defaults": { "dark": "#8c8c8c", "light": "#767676", "highContrast": "#8c8c8c" } },
            { "id": "recordStatus.mono.inProgress", "description": "Monochrome preset: in progress / active", "defaults": { "dark": "#f0f0f0", "light": "#1a1a1a", "highContrast": "#f0f0f0" } },
            { "id": "recordStatus.mono.check", "description": "Monochrome preset: built, waiting for a look", "defaults": { "dark": "#f0f0f0", "light": "#1a1a1a", "highContrast": "#f0f0f0" } },
            { "id": "recordStatus.mono.completed", "description": "Monochrome preset: completed / accepted", "defaults": { "dark": "#b4b4b4", "light": "#555555", "highContrast": "#b4b4b4" } },
            { "id": "recordStatus.mono.blocked", "description": "Monochrome preset: blocked", "defaults": { "dark": "#ffffff", "light": "#000000", "highContrast": "#ffffff" } },
            { "id": "recordStatus.mono.living", "description": "Monochrome preset: spec being built", "defaults": { "dark": "#b4b4b4", "light": "#555555", "highContrast": "#b4b4b4" } },
            { "id": "recordStatus.mono.dropped", "description": "Monochrome preset: dropped / superseded", "defaults": { "dark": "#5f5f5f", "light": "#ababab", "highContrast": "#5f5f5f" } },
            { "id": "recordStatus.mono.proposed", "description": "Monochrome preset: proposed / open / review", "defaults": { "dark": "#f0f0f0", "light": "#1a1a1a", "highContrast": "#f0f0f0" } },
            { "id": "recordStatus.dark.planned", "description": "Dark preset: planned / draft", "defaults": { "dark": "#6e7681", "light": "#57606a", "highContrast": "#6e7681" } },
            { "id": "recordStatus.dark.inProgress", "description": "Dark preset: in progress / active", "defaults": { "dark": "#c69026", "light": "#8a5a00", "highContrast": "#c69026" } },
            { "id": "recordStatus.dark.check", "description": "Dark preset: built, waiting for a look", "defaults": { "dark": "#1b9aaa", "light": "#0b5c6e", "highContrast": "#1b9aaa" } },
            { "id": "recordStatus.dark.completed", "description": "Dark preset: completed / accepted", "defaults": { "dark": "#3f9b5c", "light": "#1a6b33", "highContrast": "#3f9b5c" } },
            { "id": "recordStatus.dark.blocked", "description": "Dark preset: blocked", "defaults": { "dark": "#c9514f", "light": "#8f1d1d", "highContrast": "#c9514f" } },
            { "id": "recordStatus.dark.living", "description": "Dark preset: spec being built", "defaults": { "dark": "#4a83c9", "light": "#1c3f8f", "highContrast": "#4a83c9" } },
            { "id": "recordStatus.dark.dropped", "description": "Dark preset: dropped / superseded", "defaults": { "dark": "#4b5058", "light": "#8c959f", "highContrast": "#4b5058" } },
            { "id": "recordStatus.dark.proposed", "description": "Dark preset: proposed / open / review", "defaults": { "dark": "#6f7fc4", "light": "#3a4a9f", "highContrast": "#6f7fc4" } }
        ]
    }
}
